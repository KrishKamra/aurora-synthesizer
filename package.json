{
  "name": "aurora-synthesizer",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time aurora visualization driven by live NOAA space weather data — an honest WebGL instrument, not decorative space art.",
  "type": "module",
  "license": "MIT",
  "author": "Krish Kamra <krishkamra@gmail.com>",
  "homepage": "https://github.com/OWNER/aurora-synthesizer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/aurora-synthesizer.git"
  },
  "bugs": {
    "url": "https://github.com/OWNER/aurora-synthesizer/issues"
  },
  "files": [
    "dist",
    "docs",
    "public",
    "src",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "keywords": [
    "aurora",
    "space-weather",
    "noaa",
    "webgl",
    "threejs",
    "react-three-fiber",
    "glsl",
    "visualization",
    "kp-index",
    "vite",
    "react"
  ],
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
